 async function saveEnvelope(page: Page): Promise<unknown> {
   const { parsed } = await savePackage(page);
   expect(parsed.ok).toBe(true);
   if (!parsed.ok) throw new Error(parsed.message);
   return parsed.envelope;
 }
 
