+    const readZoom = () =>
+      page.evaluate(() =>
+        (
+          window as unknown as {
+            vigiliaEditorBridge: {
+              editor: { viewport: { zoom(): number } };
+            };
+          }
+        ).vigiliaEditorBridge.editor.viewport.zoom(),
