+    expect(viewport.zoomBy.mock.calls[0]?.[0]).toBeGreaterThan(1);
+
+    viewport.zoomBy.mockClear();
+    window.dispatchEvent(
+      new KeyboardEvent("keydown", { key: "-", bubbles: true }),
