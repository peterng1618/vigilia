+function label(
+  text: string,
+  control: HTMLInputElement | HTMLSelectElement,
+): HTMLLabelElement {
+  const result = document.createElement("label");
+  result.textContent = text;
+  result.append(control);
+  return result;
+}
+function nextId(presets: TypePresets): string {
+  for (let index = 1; ; index += 1) {
