-  target,
-  candidate,
-  preservePlacement,
-  snapGuards,
-}: {
-  target: FabricObject;
-  candidate: ScalingStepCandidate;
-  preservePlacement?: ScalingStepPlacementPreserver;
-  snapGuards: ScalingStepSnapGuard[];
