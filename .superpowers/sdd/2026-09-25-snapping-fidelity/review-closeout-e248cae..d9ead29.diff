-  candidates.sort((first, second) => {
-    const firstError =
-      Math.abs(first.scaleX - rawScaleX) + Math.abs(first.scaleY - rawScaleY);
-    const secondError =
-      Math.abs(second.scaleX - rawScaleX) + Math.abs(second.scaleY - rawScaleY);
