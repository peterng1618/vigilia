+  scaleXCandidates,
+  scaleYCandidates,
+  rawScaleX,
+  rawScaleY,
+}: {
+  scaleXCandidates: number[];
+  scaleYCandidates: number[];
+  rawScaleX: number;
+  rawScaleY: number;
