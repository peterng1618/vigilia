# Normalize text on commit and use LF in every checkout.
* text=auto eol=lf

*.sh        text eol=lf
*.json      text
*.md        text
*.ts        text
*.vue       text

# Binary assets — never diff or normalize.
*.png  binary
*.jpg  binary
*.gif  binary
*.webp binary
*.mp4  binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.bin  binary
*.sys  binary
