# ---------- Node / frontend ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
*.tsbuildinfo

# ---------- Playwright ----------
test-results/
playwright-report/
playwright/.cache/
blob-report/
# Versioned host-theme packages seeded by the browser suite.
.e2e-host-themes/
# Downloaded e2e font bytes; the licence is declared in the fixture envelope.
.e2e-font-cache/
# Staged third-party release binaries (LibreHardwareMonitor). Provenance is
# tracked in the script that stages them, never the binaries themselves.
src/web/packages/host/vendor/
# Vitest JSON reporter output (diagnostics only, never asserted against).
.vitest/

# ---------- Runtime / local data ----------
# SQLite metadata + managed asset files are user data, never committed.
# Anchored to the repository root: a bare `data/` also matched source
# directories such as renderer-core's `src/data/`, silently untracking them.
/data/
*.db
*.db-shm
*.db-wal
assets-store/
secrets.local.json

# ---------- Screenshot evidence ----------
# Commit the written results; keep raw captures local.
docs/evidence/screenshots/**/raw/

# ---------- Agent environment ----------
# Personal overrides; the committed .claude/settings.json is the shared one.
.claude/settings.local.json
# Throwaway implementation plans are not repository content. Tracked specs live
# in docs/superpowers/specs/ instead.
.claude/plans/
.worktrees/

# Credentials, at any depth. A Claude Code process launched with a cwd inside
# this repo and a home that did not resolve once created a whole config home
# under the screenshots directory — 78 MB holding live OAuth access tokens,
# untracked and NOT ignored, one `git add -A` from a credential leak. A previous
# revision recorded this as fixed when it was not. A convention with no hook
# behind it is not a control.
**/.credentials.json
# A nested .claude/ is always a stray config home. Anchored with a leading
# directory so the repo's OWN root .claude/ — twelve tracked plugin files —
# stays tracked.
**/*/.claude/

# ---------- Editors / OS ----------
.idea/
*.swp
.DS_Store
Thumbs.db
