<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows platform adapter (§97): secret storage (DPAPI/CredMan), tray icon,
    startup registration and firewall guidance.

    NOTE on §147: tray controls must be able to fully stop and start the server,
    and "a stopped server cannot restart itself through its website". A Windows
    service cannot own a tray icon (Session 0 isolation), so if this ever becomes
    a service, the tray must be a separate user-session process. Decide before
    Gate 5 rather than discovering it during installer work.
  -->
  <PropertyGroup>
    <RootNamespace>Vigilia.Platform.Windows</RootNamespace>
    <IsWindowsPlatformProject>true</IsWindowsPlatformProject>
    <Description>Windows adapters for secrets, tray, startup and firewall integration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vigilia.Platform.Abstractions\Vigilia.Platform.Abstractions.csproj" />
  </ItemGroup>

</Project>
