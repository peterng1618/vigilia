<Project Sdk="Microsoft.NET.Sdk">

  <!--
    §97: Windows hardware APIs, secret storage, startup, tray and firewall
    integration live in platform adapters. This project holds the platform-neutral
    interfaces those adapters implement, so Core and the host never reference a
    Windows type.
  -->
  <PropertyGroup>
    <RootNamespace>Vigilia.Platform.Abstractions</RootNamespace>
    <Description>Platform-neutral interfaces for secrets, tray, startup and firewall integration.</Description>
  </PropertyGroup>

</Project>
