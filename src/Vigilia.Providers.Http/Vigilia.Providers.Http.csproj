<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Custom API sensors (§99): HTTP(S) JSON endpoints, GET polling, JSON Pointer
    field mapping. Platform-neutral — secrets are reached through
    ISecretStore, never through a Windows credential API directly (§97, §101).

    Deliberately out of scope for v1: OAuth login/refresh, arbitrary scripts,
    mutation requests, streaming protocols.
  -->
  <PropertyGroup>
    <RootNamespace>Vigilia.Providers.Http</RootNamespace>
    <Description>Custom API sensor provider: HTTP(S) JSON endpoints with JSON Pointer mapping.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vigilia.Contracts\Vigilia.Contracts.csproj" />
    <ProjectReference Include="..\Vigilia.Platform.Abstractions\Vigilia.Platform.Abstractions.csproj" />
  </ItemGroup>

</Project>
