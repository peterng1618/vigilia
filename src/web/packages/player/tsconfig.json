{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // renderer-core is consumed as source via the Vite alias, so the program
    // legitimately spans two workspace packages. rootDir has to cover both or
    // TypeScript reports TS6059 for every shared file.
    "rootDir": "../..",
    "paths": {
      "@vigilia/renderer-core": ["../renderer-core/src/index.ts"],
      "@vigilia/fake-source": ["../fake-source/src/index.ts"]
    }
  },
  // The second entry is the shared narrow Node typings, owned by
  // renderer-core. `src/boundaries.test.ts` walks the source tree to assert
  // §47's import rules, and `@types/node` is deliberately absent so `fs`
  // cannot type-check inside this browser bundle. See that file's header.
  "include": ["src/**/*.ts", "../renderer-core/src/node-builtins.d.ts"]
}
