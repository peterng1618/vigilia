{
  "schemaVersion": 1,
  "id": "vigilia-demo-dashboard",
  "metadata": {
    "name": "Vigilia demo dashboard",
    "author": "Vigilia",
    "description": "Development fixture. Exercises all four chart families, styled text runs, globals, grouping and the missing-sample path. Not a shipped preset."
  },
  "artboard": {
    "width": 1280,
    "height": 720,
    "fitMode": "contain",
    "background": { "ref": "palette.canvas" },
    "barColor": { "value": "#000000" }
  },
  "globals": {
    "palette": {
      "canvas": { "name": "Canvas", "value": "#0c0e13" },
      "panel": { "name": "Panel", "value": "#151922" },
      "accent": { "name": "Accent", "value": "#00b8d9" },
      "accent2": { "name": "Accent 2", "value": "#6554c0" },
      "text": { "name": "Text", "value": "#e8ecf3" },
      "textDim": { "name": "Text dim", "value": "#7b8697" },
      "track": { "name": "Track", "value": "#222835" },
      "good": { "name": "Good", "value": "#36b37e" },
      "warn": { "name": "Warn", "value": "#ffab00" },
      "danger": { "name": "Danger", "value": "#ff5630" }
    },
    "fonts": {
      "ui": {
        "name": "UI",
        "value": "'Segoe UI Variable Display', 'Segoe UI', system-ui, sans-serif"
      }
    },
    "fontSizes": {
      "title": { "name": "Title", "value": 30 },
      "readout": { "name": "Readout", "value": 44 },
      "label": { "name": "Label", "value": 15 },
      "caption": { "name": "Caption", "value": 13 }
    }
  },
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "name": "Title",
      "transform": { "x": 48, "y": 34, "width": 700, "height": 40 },
      "style": {
        "fontFamily": { "ref": "fonts.ui" },
        "fontSize": { "ref": "fontSizes.title" },
        "fontWeight": { "value": 600 },
        "color": { "ref": "palette.text" },
        "verticalAlign": { "value": "middle" }
      },
      "content": {
        "runs": [
          { "kind": "literal", "text": "Vigilia" },
          {
            "kind": "literal",
            "text": "  demo dashboard",
            "style": {
              "color": { "ref": "palette.textDim" },
              "fontWeight": { "value": 400 }
            }
          }
        ]
      }
    },

    {
      "id": "cpu-panel",
      "type": "group",
      "name": "CPU",
      "transform": { "x": 48, "y": 100, "width": 288, "height": 288 },
      "children": [
        {
          "id": "cpu-panel-bg",
          "type": "rectangle",
          "transform": { "width": 288, "height": 288 },
          "style": { "fill": { "ref": "palette.panel" } },
          "content": { "cornerRadius": 18 }
        },
        {
          "id": "cpu-gauge",
          "type": "chart",
          "transform": { "x": 34, "y": 30, "width": 220, "height": 220 },
          "bindings": [{ "id": "cpu-load", "semanticKey": "cpu.load", "precision": 0 }],
          "content": {
            "family": "gauge",
            "settings": {
              "startAngle": 225,
              "endAngle": -45,
              "min": 0,
              "max": 100,
              "thickness": 20,
              "roundCap": true,
              "track": { "kind": "solid", "color": "#222835" },
              "progress": {
                "kind": "thresholds",
                "bands": [
                  { "offset": 0.7, "color": "#00b8d9" },
                  { "offset": 0.9, "color": "#ffab00" },
                  { "offset": 1, "color": "#ff5630" }
                ]
              }
            }
          }
        },
        {
          "id": "cpu-readout",
          "type": "text",
          "transform": { "x": 34, "y": 112, "width": 220, "height": 56 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.readout" },
            "fontWeight": { "value": 600 },
            "color": { "ref": "palette.text" },
            "align": { "value": "center" },
            "verticalAlign": { "value": "middle" },
            "tabularNumerals": { "value": true }
          },
          "bindings": [
            { "id": "cpu-load-text", "semanticKey": "cpu.load", "precision": 0, "unitDisplay": "none" }
          ],
          "content": {
            "runs": [
              { "kind": "value", "bindingId": "cpu-load-text" },
              {
                "kind": "literal",
                "text": "%",
                "style": {
                  "fontSize": { "ref": "fontSizes.label" },
                  "color": { "ref": "palette.textDim" }
                }
              }
            ]
          }
        },
        {
          "id": "cpu-label",
          "type": "text",
          "transform": { "x": 34, "y": 238, "width": 220, "height": 22 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.textDim" },
            "align": { "value": "center" }
          },
          "bindings": [
            { "id": "cpu-temp-inline", "semanticKey": "cpu.temp", "precision": 0 },
            { "id": "cpu-power-inline", "semanticKey": "cpu.power", "precision": 0 }
          ],
          "content": {
            "runs": [
              { "kind": "literal", "text": "CPU  ·  " },
              { "kind": "value", "bindingId": "cpu-temp-inline" },
              { "kind": "literal", "text": "  ·  " },
              { "kind": "value", "bindingId": "cpu-power-inline" }
            ]
          }
        }
      ]
    },

    {
      "id": "gpu-panel",
      "type": "group",
      "name": "GPU",
      "transform": { "x": 352, "y": 100, "width": 288, "height": 288 },
      "children": [
        {
          "id": "gpu-panel-bg",
          "type": "rectangle",
          "transform": { "width": 288, "height": 288 },
          "style": { "fill": { "ref": "palette.panel" } },
          "content": { "cornerRadius": 18 }
        },
        {
          "id": "gpu-gauge",
          "type": "chart",
          "transform": { "x": 34, "y": 30, "width": 220, "height": 220 },
          "bindings": [{ "id": "gpu-load", "semanticKey": "gpu.load", "precision": 0 }],
          "content": {
            "family": "gauge",
            "settings": {
              "startAngle": 225,
              "endAngle": -45,
              "min": 0,
              "max": 100,
              "thickness": 20,
              "roundCap": true,
              "gradientSegments": 64,
              "track": { "kind": "solid", "color": "#222835" },
              "progress": {
                "kind": "gradient",
                "stops": [
                  { "offset": 0, "color": "#6554c0" },
                  { "offset": 1, "color": "#00b8d9" }
                ]
              }
            }
          }
        },
        {
          "id": "gpu-readout",
          "type": "text",
          "transform": { "x": 34, "y": 112, "width": 220, "height": 56 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.readout" },
            "fontWeight": { "value": 600 },
            "color": { "ref": "palette.text" },
            "align": { "value": "center" },
            "verticalAlign": { "value": "middle" },
            "tabularNumerals": { "value": true }
          },
          "bindings": [
            { "id": "gpu-load-text", "semanticKey": "gpu.load", "precision": 0, "unitDisplay": "none" }
          ],
          "content": {
            "runs": [
              { "kind": "value", "bindingId": "gpu-load-text" },
              {
                "kind": "literal",
                "text": "%",
                "style": {
                  "fontSize": { "ref": "fontSizes.label" },
                  "color": { "ref": "palette.textDim" }
                }
              }
            ]
          }
        },
        {
          "id": "gpu-label",
          "type": "text",
          "transform": { "x": 34, "y": 238, "width": 220, "height": 22 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.textDim" },
            "align": { "value": "center" }
          },
          "bindings": [
            { "id": "gpu-temp-inline", "semanticKey": "gpu.temp", "precision": 0 },
            { "id": "gpu-clock-inline", "semanticKey": "gpu.clock", "precision": 0 }
          ],
          "content": {
            "runs": [
              { "kind": "literal", "text": "GPU  ·  " },
              { "kind": "value", "bindingId": "gpu-temp-inline" },
              { "kind": "literal", "text": "  ·  " },
              { "kind": "value", "bindingId": "gpu-clock-inline" }
            ]
          }
        }
      ]
    },

    {
      "id": "history-panel",
      "type": "group",
      "name": "Load history",
      "transform": { "x": 656, "y": 100, "width": 576, "height": 288 },
      "children": [
        {
          "id": "history-bg",
          "type": "rectangle",
          "transform": { "width": 576, "height": 288 },
          "style": { "fill": { "ref": "palette.panel" } },
          "content": { "cornerRadius": 18 }
        },
        {
          "id": "history-title",
          "type": "text",
          "transform": { "x": 24, "y": 20, "width": 400, "height": 22 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.textDim" }
          },
          "content": { "runs": [{ "kind": "literal", "text": "Load  ·  last 60 s" }] }
        },
        {
          "id": "history-chart",
          "type": "chart",
          "transform": { "x": 16, "y": 52, "width": 544, "height": 216 },
          "bindings": [
            { "id": "hist-cpu", "semanticKey": "cpu.load" },
            { "id": "hist-gpu", "semanticKey": "gpu.load" }
          ],
          "content": {
            "family": "line",
            "settings": {
              "lineWidth": 2,
              "interpolation": "smooth",
              "stroke": { "kind": "solid", "color": "#00b8d9" },
              "palette": [
                { "kind": "solid", "color": "#00b8d9" },
                { "kind": "solid", "color": "#ffab00" }
              ],
              "area": {
                "kind": "gradient",
                "stops": [
                  { "offset": 0, "color": "#00b8d9" },
                  { "offset": 1, "color": "#151922" }
                ]
              },
              "showMarkers": false,
              "markerSize": 4,
              "windowSeconds": 60,
              "maxPoints": 600,
              "min": 0,
              "max": 100,
              "showAxes": false,
              "sampling": "none"
            }
          }
        }
      ]
    },

    {
      "id": "thermals-panel",
      "type": "group",
      "name": "Thermals",
      "transform": { "x": 48, "y": 404, "width": 592, "height": 272 },
      "children": [
        {
          "id": "thermals-bg",
          "type": "rectangle",
          "transform": { "width": 592, "height": 272 },
          "style": { "fill": { "ref": "palette.panel" } },
          "content": { "cornerRadius": 18 }
        },
        {
          "id": "thermals-title",
          "type": "text",
          "transform": { "x": 24, "y": 20, "width": 400, "height": 22 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.textDim" }
          },
          "content": {
            "runs": [{ "kind": "literal", "text": "Temperatures  ·  thresholds per bar" }]
          }
        },
        {
          "id": "thermals-bars",
          "type": "chart",
          "transform": { "x": 24, "y": 56, "width": 544, "height": 120 },
          "bindings": [
            { "id": "bar-cpu-temp", "semanticKey": "cpu.temp" },
            { "id": "bar-gpu-temp", "semanticKey": "gpu.temp" }
          ],
          "content": {
            "family": "bar",
            "settings": {
              "orientation": "horizontal",
              "min": 20,
              "max": 100,
              "barWidth": 22,
              "categoryGapPercent": 55,
              "cornerRadius": 11,
              "showAxes": false,
              "showCategoryLabels": false,
              "track": { "kind": "solid", "color": "#222835" },
              "fill": {
                "kind": "thresholds",
                "bands": [
                  { "offset": 0.55, "color": "#36b37e" },
                  { "offset": 0.78, "color": "#ffab00" },
                  { "offset": 1, "color": "#ff5630" }
                ]
              }
            }
          }
        },
        {
          "id": "thermals-cpu-label",
          "type": "text",
          "transform": { "x": 24, "y": 186, "width": 260, "height": 24 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.caption" },
            "color": { "ref": "palette.textDim" }
          },
          "bindings": [{ "id": "cap-cpu-temp", "semanticKey": "cpu.temp", "precision": 1 }],
          "content": {
            "runs": [
              { "kind": "literal", "text": "CPU package  " },
              {
                "kind": "value",
                "bindingId": "cap-cpu-temp",
                "style": { "color": { "ref": "palette.text" } }
              }
            ]
          }
        },
        {
          "id": "thermals-gpu-label",
          "type": "text",
          "transform": { "x": 24, "y": 214, "width": 400, "height": 24 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.caption" },
            "color": { "ref": "palette.textDim" }
          },
          "bindings": [{ "id": "cap-gpu-temp", "semanticKey": "gpu.temp", "precision": 1 }],
          "content": {
            "runs": [
              { "kind": "literal", "text": "GPU core  " },
              {
                "kind": "value",
                "bindingId": "cap-gpu-temp",
                "style": { "color": { "ref": "palette.text" } }
              },
              {
                "kind": "literal",
                "text": "   (outage simulated — shows a gap, not a zero)",
                "style": { "color": { "ref": "palette.warn" } }
              }
            ]
          }
        }
      ]
    },

    {
      "id": "memory-panel",
      "type": "group",
      "name": "Memory",
      "transform": { "x": 656, "y": 404, "width": 576, "height": 272 },
      "children": [
        {
          "id": "memory-bg",
          "type": "rectangle",
          "transform": { "width": 576, "height": 272 },
          "style": { "fill": { "ref": "palette.panel" } },
          "content": { "cornerRadius": 18 }
        },
        {
          "id": "memory-title",
          "type": "text",
          "transform": { "x": 24, "y": 20, "width": 400, "height": 22 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.textDim" }
          },
          "content": {
            "runs": [{ "kind": "literal", "text": "Memory  ·  32 GB installed" }]
          }
        },
        {
          "id": "memory-donut",
          "type": "chart",
          "transform": { "x": 36, "y": 52, "width": 196, "height": 196 },
          "bindings": [{ "id": "ram-used", "semanticKey": "ram.used" }],
          "content": {
            "family": "pie",
            "settings": {
              "innerRadiusPercent": 68,
              "outerRadiusPercent": 100,
              "startAngle": 90,
              "padAngle": 2,
              "cornerRadius": 4,
              "showLabels": false,
              "total": { "kind": "fixed", "value": 32 },
              "remainderFill": { "kind": "solid", "color": "#222835" },
              "palette": [{ "kind": "solid", "color": "#6554c0" }]
            }
          }
        },
        {
          "id": "memory-readout",
          "type": "text",
          "transform": { "x": 260, "y": 96, "width": 280, "height": 56 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.readout" },
            "fontWeight": { "value": 600 },
            "color": { "ref": "palette.text" },
            "verticalAlign": { "value": "middle" },
            "tabularNumerals": { "value": true }
          },
          "bindings": [{ "id": "ram-used-text", "semanticKey": "ram.used", "precision": 1 }],
          "content": {
            "runs": [
              { "kind": "value", "bindingId": "ram-used-text" },
              {
                "kind": "literal",
                "text": "  / 32 GB",
                "style": {
                  "fontSize": { "ref": "fontSizes.label" },
                  "color": { "ref": "palette.textDim" }
                }
              }
            ]
          }
        },
        {
          "id": "memory-unmapped",
          "type": "text",
          "transform": { "x": 260, "y": 158, "width": 290, "height": 24 },
          "style": {
            "fontFamily": { "ref": "fonts.ui" },
            "fontSize": { "ref": "fontSizes.caption" },
            "color": { "ref": "palette.textDim" }
          },
          "bindings": [{ "id": "unmapped-demo", "semanticKey": "disk.nvme.queue-depth" }],
          "content": {
            "runs": [
              { "kind": "literal", "text": "Unmapped key renders as  " },
              {
                "kind": "value",
                "bindingId": "unmapped-demo",
                "style": { "color": { "ref": "palette.danger" } }
              }
            ]
          }
        }
      ]
    }
  ]
}
