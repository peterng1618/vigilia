{
  "schemaVersion": 1,
  "id": "assets-showcase",
  "metadata": {
    "name": "Assets",
    "description": "Image nodes: the three fit modes, monochrome recolouring (§111), a transparent PNG over a patterned background, an inline SVG, and one deliberately unresolvable reference. Gate 0 asks for transparent artwork; this is where it is demonstrated."
  },
  "artboard": {
    "width": 960,
    "height": 540,
    "fitMode": "contain",
    "background": { "value": "#101318" }
  },
  "globals": {
    "palette": {
      "ink": { "name": "Ink", "value": "#e8ecf3" },
      "dim": { "name": "Dim", "value": "#7b8697" },
      "accent": { "name": "Accent", "value": "#ffab00" },
      "swatch": { "name": "Swatch", "value": "#1d2530" }
    },
    "fontSizes": {
      "label": { "name": "Label", "value": 13 },
      "title": { "name": "Title", "value": 22 }
    }
  },
  "assets": [
    {
      "id": "ring",
      "kind": "image",
      "path": "assets/ring.png",
      "sourceUrl": "https://vigilia.local/generated",
      "license": {
        "name": "MIT",
        "attribution": "Generated by the Vigilia repository for test fixtures."
      }
    },
    {
      "id": "thermometer",
      "kind": "svg",
      "path": "assets/thermometer.svg",
      "license": {
        "name": "MIT",
        "attribution": "Hand-authored in the Vigilia repository."
      }
    },
    {
      "id": "absent",
      "kind": "image",
      "path": "assets/not-shipped.png"
    }
  ],
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "transform": { "x": 40, "y": 28, "width": 600, "height": 30 },
      "style": {
        "fontSize": { "ref": "fontSizes.title" },
        "fontWeight": { "value": 600 },
        "color": { "ref": "palette.ink" }
      },
      "content": {
        "verticalAlign": "middle",
        "runs": [{ "kind": "literal", "text": "Assets" }]
      }
    },

    {
      "id": "fit-row",
      "type": "group",
      "name": "The three fit modes, same artwork and box",
      "transform": { "x": 40, "y": 80, "width": 880, "height": 200 },
      "children": [
        {
          "id": "fit-contain-bg",
          "type": "rectangle",
          "transform": { "x": 0, "y": 0, "width": 260, "height": 150 },
          "style": { "fill": { "ref": "palette.swatch" } },
          "content": { "cornerRadius": 10 }
        },
        {
          "id": "fit-contain",
          "type": "image",
          "transform": { "x": 0, "y": 0, "width": 260, "height": 150 },
          "content": { "assetId": "ring", "fit": "contain" }
        },
        {
          "id": "fit-contain-label",
          "type": "text",
          "transform": { "x": 0, "y": 158, "width": 260, "height": 20 },
          "style": {
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.dim" }
          },
          "content": {
            "align": "center",
            "runs": [
              {
                "kind": "literal",
                "text": "contain — whole image, letterboxed"
              }
            ]
          }
        },

        {
          "id": "fit-cover-bg",
          "type": "rectangle",
          "transform": { "x": 300, "y": 0, "width": 260, "height": 150 },
          "style": { "fill": { "ref": "palette.swatch" } },
          "content": { "cornerRadius": 10 }
        },
        {
          "id": "fit-cover",
          "type": "image",
          "transform": { "x": 300, "y": 0, "width": 260, "height": 150 },
          "content": { "assetId": "ring", "fit": "cover" }
        },
        {
          "id": "fit-cover-label",
          "type": "text",
          "transform": { "x": 300, "y": 158, "width": 260, "height": 20 },
          "style": {
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.dim" }
          },
          "content": {
            "align": "center",
            "runs": [
              { "kind": "literal", "text": "cover — fills, crops the ring" }
            ]
          }
        },

        {
          "id": "fit-stretch-bg",
          "type": "rectangle",
          "transform": { "x": 600, "y": 0, "width": 260, "height": 150 },
          "style": { "fill": { "ref": "palette.swatch" } },
          "content": { "cornerRadius": 10 }
        },
        {
          "id": "fit-stretch",
          "type": "image",
          "transform": { "x": 600, "y": 0, "width": 260, "height": 150 },
          "content": { "assetId": "ring", "fit": "stretch" }
        },
        {
          "id": "fit-stretch-label",
          "type": "text",
          "transform": { "x": 600, "y": 158, "width": 260, "height": 20 },
          "style": {
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.dim" }
          },
          "content": {
            "align": "center",
            "runs": [
              { "kind": "literal", "text": "stretch — distorts, and shows it" }
            ]
          }
        }
      ]
    },

    {
      "id": "mono-row",
      "type": "group",
      "name": "Monochrome recolouring and an SVG",
      "transform": { "x": 40, "y": 310, "width": 880, "height": 200 },
      "children": [
        {
          "id": "svg-original",
          "type": "image",
          "name": "SVG as authored",
          "transform": { "x": 0, "y": 0, "width": 96, "height": 96 },
          "content": { "assetId": "thermometer", "fit": "contain" }
        },
        {
          "id": "svg-mono",
          "type": "image",
          "name": "Same SVG, recoloured",
          "transform": { "x": 120, "y": 0, "width": 96, "height": 96 },
          "content": {
            "assetId": "thermometer",
            "fit": "contain",
            "monochrome": { "ref": "palette.accent" }
          }
        },
        {
          "id": "png-mono",
          "type": "image",
          "name": "PNG recoloured — alpha only, colours discarded",
          "transform": { "x": 240, "y": 0, "width": 96, "height": 96 },
          "content": {
            "assetId": "ring",
            "fit": "contain",
            "monochrome": { "value": "#36b37e" }
          }
        },
        {
          "id": "mono-label",
          "type": "text",
          "transform": { "x": 0, "y": 104, "width": 360, "height": 20 },
          "style": {
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.dim" }
          },
          "content": {
            "runs": [
              {
                "kind": "literal",
                "text": "as authored · recoloured · recoloured"
              }
            ]
          }
        },

        {
          "id": "absent-image",
          "type": "image",
          "name": "Declared but not shipped",
          "transform": { "x": 560, "y": 0, "width": 96, "height": 96 },
          "content": { "assetId": "absent", "fit": "contain" }
        },
        {
          "id": "absent-label",
          "type": "text",
          "transform": { "x": 560, "y": 104, "width": 320, "height": 40 },
          "style": {
            "fontSize": { "ref": "fontSizes.label" },
            "color": { "ref": "palette.dim" }
          },
          "content": {
            "wrap": true,
            "overflow": "visible",
            "runs": [
              {
                "kind": "literal",
                "text": "Declared in the document, absent from the package. It RESOLVES to a URL — a valid path always does — so the miss is only detectable when the load fails. Hidden rather than shown as a broken-image glyph."
              }
            ]
          }
        }
      ]
    }
  ]
}
