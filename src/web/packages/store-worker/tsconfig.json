{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Worker runtime, not a browser: DOM lib would duplicate the Request,
    // Response and ExecutionContext declarations workers-types already owns.
    "lib": ["ES2022"],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
