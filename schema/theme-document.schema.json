{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigilia.local/schema/theme-document/1.json",
  "title": "Vigilia theme document",
  "description": "The owned theme format (§134). Fabric JSON, DOM snapshots and raw ECharts options are explicitly NOT this format — they are engine details behind the renderer. This file is the published contract; the in-memory shape is src/web/packages/renderer-core/src/theme/document.ts, and schema-sync.test.ts asserts the shared constants match. Rules this schema language cannot express — reference resolution, ID uniqueness, tree depth and node count — are enforced by theme/validate.ts, which is the authority for import.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "artboard", "nodes"],
  "properties": {
    "schemaVersion": {
      "description": "Integer document version. An unsupported version must fail import without changing the library (§141). There are no migrations yet, so this build accepts exactly 1.",
      "type": "integer",
      "minimum": 1
    },
    "id": { "$ref": "#/$defs/stableId" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "author": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "artboard": { "$ref": "#/$defs/artboard" },
    "globals": {
      "description": "Named, typed constants (§73). V1 holds literals only — no scripts, no sensor expressions, so reference cycles are impossible by construction.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": { "$ref": "#/$defs/globalGroup" },
        "fonts": { "$ref": "#/$defs/globalGroup" },
        "fontSizes": { "$ref": "#/$defs/globalGroup" },
        "spacing": { "$ref": "#/$defs/globalGroup" },
        "assets": { "$ref": "#/$defs/globalGroup" }
      }
    },
    "nodes": {
      "description": "Ordered node tree. Child order alone determines stacking (§137) — there is no z-index. Depth and total count are bounded by the validator, not here.",
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/assetReference" }
    },
    "editorMetadata": {
      "description": "Rulers, grid and guides (§64). Persisted with the document but never part of rendering — and never part of undo for telemetry or viewport state (§67).",
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "stableId": {
      "description": "Stable machine identifier. Renaming must preserve links, so display names live in a separate field (§75).",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },

    "artboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 },
        "background": { "$ref": "#/$defs/styleValue" },
        "fitMode": {
          "description": "§53: 'contain' fits the whole design with colour bars; 'cover' fills and crops.",
          "enum": ["contain", "cover"],
          "default": "contain"
        },
        "barColor": { "$ref": "#/$defs/styleValue" }
      }
    },

    "globalGroup": {
      "type": "object",
      "description": "Map of stable ID to a named literal.",
      "propertyNames": { "$ref": "#/$defs/stableId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "value": {}
        }
      }
    },

    "styleValue": {
      "description": "§75: every compatible property is EITHER a global reference OR its own literal — never both, and never a bare value whose origin is ambiguous. Inspectors surface this choice explicitly with 'use global' / 'make local'.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^(palette|fonts|fontSizes|spacing|assets)\\.[A-Za-z0-9_-]{1,64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": { "value": {} }
        }
      ]
    },

    "styleMap": {
      "description": "Style properties, each a reference or a literal. The renderer writes a FIXED list of these and ignores the rest — the theme format owns its property names, and letting arbitrary keys reach CSS would make the format depend on whatever a browser happens to accept. Recognised today: fill, color, opacity, strokeColor, strokeWidth, strokeDash, shadowColor, shadowBlur, shadowOffsetX, shadowOffsetY, fontFamily, fontSize, fontWeight, letterSpacing, lineHeight, tabularNumerals. Text ALIGNMENT is not a style property — it is layout, and lives on textContent.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/styleValue" }
    },

    "transform": {
      "description": "Group-local coordinates (§57). Grouping and ungrouping must preserve world appearance, so transforms compose rather than being baked.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "default": 0 },
        "y": { "type": "number", "default": 0 },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360, "default": 0 },
        "scaleX": { "type": "number", "default": 1 },
        "scaleY": { "type": "number", "default": 1 }
      }
    },

    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": {
          "description": "V1 node types. Shapes are deliberately minimal (§43): rectangle, ellipse and line only, to prove extensible node types without building a general graphics editor first.",
          "enum": [
            "group",
            "rectangle",
            "ellipse",
            "line",
            "text",
            "chart",
            "image",
            "video"
          ]
        },
        "name": { "type": "string", "maxLength": 120 },
        "transform": { "$ref": "#/$defs/transform" },
        "visible": { "type": "boolean", "default": true },
        "locked": {
          "description": "§61: a locked object stays inspectable in the tree but cannot transform until unlocked.",
          "type": "boolean",
          "default": false
        },
        "provenance": {
          "description": "§138: where an inserted widget copy came from. V1 insertion embeds a copy with no automatic library-update propagation, so this records origin rather than maintaining a live link. Present only on the roots of an inserted subtree.",
          "$ref": "#/$defs/widgetProvenance"
        },
        "style": { "$ref": "#/$defs/styleMap" },
        "content": {
          "description": "Typed per node type. The validator selects the matching shape: chartContent, textContent, imageContent, videoContent, or rectangleContent.",
          "type": "object"
        },
        "bindings": {
          "description": "Ordered sensor bindings. A node type that reads no data must declare none — a binding nothing reads would silently do nothing. A text element may declare several so styled runs can show different live values (§89).",
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/binding" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "group" } }, "required": ["type"] },
          "then": { "required": ["children"] }
        },
        {
          "if": { "properties": { "type": { "const": "chart" } }, "required": ["type"] },
          "then": {
            "required": ["content", "bindings"],
            "properties": { "content": { "$ref": "#/$defs/chartContent" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": {
            "required": ["content"],
            "properties": { "content": { "$ref": "#/$defs/textContent" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
          "then": {
            "required": ["content"],
            "properties": { "content": { "$ref": "#/$defs/imageContent" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": {
            "required": ["content"],
            "properties": { "content": { "$ref": "#/$defs/videoContent" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "rectangle" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/rectangleContent" } } }
        }
      ]
    },

    "binding": {
      "description": "§93: themes bind to semantic keys, and a mapping layer resolves them to actual sensors — so changing providers must not require editing the theme. A theme therefore never stores a provider instance ID.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semanticKey"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "semanticKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 6 },
        "unitDisplay": { "enum": ["none", "short", "long"], "default": "short" },
        "scale": { "type": "number" },
        "offset": { "type": "number" }
      }
    },

    "widgetProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widgetId"],
      "properties": {
        "widgetId": { "$ref": "#/$defs/stableId" },
        "widgetName": { "type": "string", "maxLength": 120 },
        "widgetVersion": { "type": "string", "maxLength": 40 },
        "insertedAt": { "type": "string", "format": "date-time" }
      }
    },

    "rectangleContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cornerRadius": { "type": "number", "minimum": 0 }
      }
    },

    "textContent": {
      "description": "§89: styled runs, so a label, a live value and a unit can be styled differently inside one text box. Overflow is explicit — clipping and ellipsis are authored, never silent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["runs"],
      "properties": {
        "runs": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/textRun" }
        },
        "wrap": { "type": "boolean", "default": false },
        "overflow": { "enum": ["clip", "ellipsis", "visible"], "default": "clip" },
        "align": { "enum": ["left", "center", "right"], "default": "left" },
        "verticalAlign": { "enum": ["top", "middle", "bottom"], "default": "top" }
      }
    },

    "textRun": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "literal" },
            "text": { "type": "string", "maxLength": 2000 },
            "style": { "$ref": "#/$defs/styleMap" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bindingId"],
          "properties": {
            "kind": { "const": "value" },
            "bindingId": {
              "description": "Must name a binding declared on the SAME node. A run reading another node's binding would make this element depend on a node it has no relationship to.",
              "$ref": "#/$defs/stableId"
            },
            "precision": { "type": "integer", "minimum": 0, "maximum": 6 },
            "unitDisplay": { "enum": ["none", "short", "long"] },
            "style": { "$ref": "#/$defs/styleMap" }
          }
        }
      ]
    },

    "chartContent": {
      "description": "§87: typed chart settings translated into engine configuration. Raw executable options never appear here. The settings shapes are the same ones the renderer's adapters accept, so the format and the renderer cannot disagree about what a gauge is.",
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "settings"],
      "properties": {
        "family": { "enum": ["gauge", "line", "bar", "pie"] },
        "settings": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "family": { "const": "gauge" } }, "required": ["family"] },
          "then": { "properties": { "settings": { "$ref": "#/$defs/gaugeSettings" } } }
        },
        {
          "if": { "properties": { "family": { "const": "line" } }, "required": ["family"] },
          "then": { "properties": { "settings": { "$ref": "#/$defs/lineSettings" } } }
        },
        {
          "if": { "properties": { "family": { "const": "bar" } }, "required": ["family"] },
          "then": { "properties": { "settings": { "$ref": "#/$defs/barSettings" } } }
        },
        {
          "if": { "properties": { "family": { "const": "pie" } }, "required": ["family"] },
          "then": { "properties": { "settings": { "$ref": "#/$defs/pieSettings" } } }
        }
      ]
    },

    "fill": {
      "description": "Thresholds and gradients are deliberately distinct. Thresholds are discrete bands with semantic meaning ('above 80 °C is red'); a gradient is decorative. A band's offset is the UPPER bound of its span, consistently across every family.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "color"],
          "properties": {
            "kind": { "const": "solid" },
            "color": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bands"],
          "properties": {
            "kind": { "const": "thresholds" },
            "bands": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/gradientStop" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stops"],
          "properties": {
            "kind": { "const": "gradient" },
            "stops": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/gradientStop" } }
          }
        }
      ]
    },

    "gradientStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "color"],
      "properties": {
        "offset": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": {
          "description": "Hex (#rgb or #rrggbb) is required wherever interpolation happens: a CSS colour keyword cannot be mixed, and the renderer falls back to an endpoint instead.",
          "type": "string"
        }
      }
    },

    "gaugeSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startAngle", "endAngle", "min", "max", "thickness", "track", "progress", "roundCap"],
      "properties": {
        "startAngle": { "type": "number", "minimum": -360, "maximum": 360 },
        "endAngle": { "type": "number", "minimum": -360, "maximum": 360 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "track": { "$ref": "#/$defs/fill" },
        "progress": { "$ref": "#/$defs/fill" },
        "roundCap": { "type": "boolean" },
        "gradientSegments": {
          "description": "Segments used to approximate an angular gradient, which the engine cannot express natively on an arc (§85).",
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        }
      }
    },

    "lineSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineWidth",
        "interpolation",
        "stroke",
        "showMarkers",
        "markerSize",
        "windowSeconds",
        "maxPoints",
        "showAxes"
      ],
      "properties": {
        "lineWidth": { "type": "number", "minimum": 0 },
        "interpolation": { "enum": ["linear", "smooth", "step"] },
        "dash": {
          "description": "Applies to every series. Per-series patterns are deliberately not offered: distinguishing series is the palette's job, and varying both reads as two encodings of one fact.",
          "enum": ["solid", "dashed", "dotted"]
        },
        "stroke": {
          "description": "Stroke for the first series, and the fallback for any series the palette does not cover.",
          "$ref": "#/$defs/fill"
        },
        "palette": {
          "description": "Per-series strokes, cycled by series index. Without it every series draws in `stroke`, which is not a multi-series chart in any useful sense.",
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/fill" }
        },
        "area": {
          "description": "Area fill under the FIRST series only. Stacked translucent areas turn into mud and hide the crossings a multi-series chart exists to show.",
          "$ref": "#/$defs/fill"
        },
        "showMarkers": { "type": "boolean" },
        "markerSize": { "type": "number", "minimum": 0 },
        "windowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maxPoints": {
          "description": "§122: retained points are bounded. When exceeded the oldest are dropped; nothing is averaged, so no value is invented.",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "showAxes": { "type": "boolean" },
        "sampling": { "enum": ["lttb", "average", "none"] }
      }
    },

    "barSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation",
        "min",
        "max",
        "categoryGapPercent",
        "cornerRadius",
        "fill",
        "showAxes",
        "showCategoryLabels"
      ],
      "properties": {
        "orientation": { "enum": ["horizontal", "vertical"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "barWidth": { "type": "number", "exclusiveMinimum": 0 },
        "categoryGapPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "fill": { "$ref": "#/$defs/fill" },
        "track": {
          "description": "Present makes this a progress bar; absent makes it a plain bar chart.",
          "$ref": "#/$defs/fill"
        },
        "showAxes": { "type": "boolean" },
        "showCategoryLabels": { "type": "boolean" }
      }
    },

    "pieSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "innerRadiusPercent",
        "outerRadiusPercent",
        "startAngle",
        "padAngle",
        "cornerRadius",
        "total",
        "palette",
        "showLabels"
      ],
      "properties": {
        "innerRadiusPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "outerRadiusPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "startAngle": { "type": "number", "minimum": -360, "maximum": 360 },
        "endAngle": { "type": "number", "minimum": -360, "maximum": 360 },
        "padAngle": { "type": "number", "minimum": 0, "maximum": 90 },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "total": {
          "description": "How the whole is determined. 'sum' means the known parts ARE the whole; 'fixed' names an authored total whose unaccounted remainder is a real measured quantity. §83 requires pie composition to be distinguished from gauge progress, and this is where that distinction lives.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "sum" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "const": "fixed" },
                "value": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "remainderFill": {
          "description": "Only ever drawn for a fixed total, because only then is the remainder measurable.",
          "$ref": "#/$defs/fill"
        },
        "palette": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/fill" } },
        "showLabels": {
          "description": "Engine-drawn labels. Off by default: typography is rendered by our own text elements (§91), which is the only way shared tokens apply.",
          "type": "boolean"
        }
      }
    },

    "imageContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId"],
      "properties": {
        "assetId": { "$ref": "#/$defs/stableId" },
        "fit": { "enum": ["contain", "cover", "stretch"], "default": "contain" },
        "monochrome": {
          "description": "§111: monochrome recolouring for imported SVG icons, which must preserve multicolour originals unless recoloured explicitly.",
          "$ref": "#/$defs/styleValue"
        }
      }
    },

    "videoContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId"],
      "properties": {
        "assetId": { "$ref": "#/$defs/stableId" },
        "loop": { "type": "boolean", "default": true },
        "muted": { "type": "boolean", "default": true }
      }
    },

    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["image", "svg", "gif", "video", "font"] },
        "path": {
          "description": "Package-relative path under assets/. NOTE: this pattern permits dots, so it does NOT by itself reject '..' traversal — the validator rejects a '..' segment explicitly, and that check is the one that holds. Absolute paths and symlinks are rejected at import (§141).",
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9._/-]{1,200}$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "license": {
          "description": "§132: a URL alone does not establish reuse rights. Record what was actually supplied, and preserve required notices in packages.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "maxLength": 200 },
            "url": { "type": "string", "format": "uri" },
            "attribution": { "type": "string", "maxLength": 500 }
          }
        }
      }
    }
  }
}
